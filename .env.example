# ─── Front-end (Vite) ────────────────────────────────────────────────────────
# mock   → simulador local no navegador (padrão, não precisa do servidor)
# fabric → telemetria via proxy (/api) lida do Eventhouse do Fabric RTI
VITE_TELEMETRY_MODE=mock
# Opcional: define a fonte inicial apenas da Pharma; vazio herda VITE_TELEMETRY_MODE.
VITE_PHARMA_TELEMETRY_MODE=
# Cenário inicial sem escolha válida salva no navegador:
# factory | farm | energy | mining | pharma. Independente do SCENARIO do simulador.
VITE_DEFAULT_SCENARIO=factory
# mock    → assistente local com contexto e sugestões da planta
# foundry → agente real; cada pergunta leva o contexto ao vivo da planta (alertas, máquina selecionada)
VITE_AGENT_MODE=mock
# Os dois modos se aplicam a Factory, Farm, Energy, Mining e Pharma.

# ─── Proxy (server/index.js) ─────────────────────────────────────────────────
API_PORT=8787
# Restringe o proxy sem autenticação à máquina local. Vazio usa o padrão do Node.
API_HOST=127.0.0.1

# Fabric Real-Time Intelligence
# Eventstream → fonte "Custom endpoint" (protocolo Event Hubs, chave SAS)
FABRIC_EVENTSTREAM_CONNECTION_STRING=
FABRIC_EVENTSTREAM_NAME=
# Eventhouse (KQL) — Query URI e banco
FABRIC_KUSTO_URI=https://<seu-eventhouse>.kusto.fabric.microsoft.com
FABRIC_KUSTO_DATABASE=IoTFactory
FABRIC_KUSTO_SCOPE=https://kusto.kusto.windows.net/.default
# Opcional: tenant do Eventhouse, quando diferente do tenant padrão do Foundry.
FABRIC_KUSTO_TENANT_ID=
FABRIC_TELEMETRY_TABLE=MachineTelemetry
FABRIC_POLL_MS=3000
# Exemplo para ingestão real: ajuste conforme a latência; o padrão do proxy é 15 s.
FABRIC_STALE_SEC=90
# Destinos opcionais por cenário (deixe todos vazios para usar o Fabric compartilhado acima).
# Um único campo de destino não vazio desativa toda a herança dos campos de destino compartilhados.
# Publicação: connection string e, sem EntityPath, nome do Event Hub do cenário.
# Consulta: URI, banco e tabela do cenário. Tenant vazio usa a credencial padrão, não o tenant compartilhado.
# Scope, poll e stale continuam compartilhados. Configurações parciais aparecem como não configuradas.
FABRIC_FACTORY_EVENTSTREAM_CONNECTION_STRING=
FABRIC_FACTORY_EVENTSTREAM_NAME=
FABRIC_FACTORY_KUSTO_URI=
FABRIC_FACTORY_KUSTO_DATABASE=
FABRIC_FACTORY_TELEMETRY_TABLE=
FABRIC_FACTORY_KUSTO_TENANT_ID=

FABRIC_FARM_EVENTSTREAM_CONNECTION_STRING=
FABRIC_FARM_EVENTSTREAM_NAME=
FABRIC_FARM_KUSTO_URI=
FABRIC_FARM_KUSTO_DATABASE=
FABRIC_FARM_TELEMETRY_TABLE=
FABRIC_FARM_KUSTO_TENANT_ID=

FABRIC_ENERGY_EVENTSTREAM_CONNECTION_STRING=
FABRIC_ENERGY_EVENTSTREAM_NAME=
FABRIC_ENERGY_KUSTO_URI=
FABRIC_ENERGY_KUSTO_DATABASE=
FABRIC_ENERGY_TELEMETRY_TABLE=
FABRIC_ENERGY_KUSTO_TENANT_ID=

FABRIC_MINING_EVENTSTREAM_CONNECTION_STRING=
FABRIC_MINING_EVENTSTREAM_NAME=
FABRIC_MINING_KUSTO_URI=
FABRIC_MINING_KUSTO_DATABASE=
FABRIC_MINING_TELEMETRY_TABLE=
FABRIC_MINING_KUSTO_TENANT_ID=

FABRIC_PHARMA_EVENTSTREAM_CONNECTION_STRING=
FABRIC_PHARMA_EVENTSTREAM_NAME=
FABRIC_PHARMA_KUSTO_URI=
FABRIC_PHARMA_KUSTO_DATABASE=
FABRIC_PHARMA_TELEMETRY_TABLE=
FABRIC_PHARMA_KUSTO_TENANT_ID=

# Sem Fabric? true = o proxy emula Eventstream+Eventhouse em memória (testa o caminho fabric ponta a ponta)
# Um cenário com override parcial continua em erro, mesmo com loopback ativo.
FABRIC_LOOPBACK=false
# Simulador de dispositivos (npm run simulate:devices)
# factory | farm | energy | mining | pharma; um processo por cenário para publicar simultaneamente
SCENARIO=factory
DEVICE_INTERVAL_MS=2000
# Controle HTTP local do simulador (padrao: http://localhost:${API_PORT})
DEVICE_CONTROL_URL=http://localhost:8787

# Microsoft Foundry Agent Service (autenticação via DefaultAzureCredential / az login)
FOUNDRY_PROJECT_ENDPOINT=https://<recurso>.services.ai.azure.com/api/projects/<projeto>
FOUNDRY_AGENT_NAME=
# Nomes opcionais por cenário; vazios usam FOUNDRY_AGENT_NAME ou o ID clássico.
FOUNDRY_FACTORY_AGENT_NAME=
FOUNDRY_FARM_AGENT_NAME=
FOUNDRY_ENERGY_AGENT_NAME=
FOUNDRY_MINING_AGENT_NAME=
FOUNDRY_PHARMA_AGENT_NAME=
# Compatibilidade opcional com o Agent Service clássico (ID asst_...):
# FOUNDRY_AGENT_ID=
FOUNDRY_API_VERSION=2025-11-15-preview
FOUNDRY_SCOPE=https://ai.azure.com/.default
# true = registra mensagens, payload exato enviado e resposta no console do proxy
FOUNDRY_DEBUG=false
# logs das chamadas ao agente no console do navegador (padrão: ligado em dev)
VITE_AGENT_DEBUG=
